# Copy to `.env` for local development. Never commit real secrets.
# Tests read `.env.test.local` (NODE_ENV=test), which should point at the bizretriever_test database.

NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3000

# --- Database (ARCHITECTURE §6) -------------------------------------------------------------
# One login role per purpose. `pnpm db:setup` creates these roles using the user/password in each
# URL, so the URLs are the single source of truth. Dev-only passwords below; change for any shared DB.
DATABASE_URL_SUPERUSER=postgres://postgres:postgres@localhost:5432/bizretriever
DATABASE_URL_MIGRATE=postgres://bizr_owner:dev_owner_pw@localhost:5432/bizretriever
DATABASE_URL_APP=postgres://bizr_app:dev_app_pw@localhost:5432/bizretriever
DATABASE_URL_ADMIN=postgres://bizr_admin:dev_admin_pw@localhost:5432/bizretriever
DATABASE_URL_TENANT=postgres://bizr_tenant:dev_tenant_pw@localhost:5432/bizretriever

# --- Background jobs (ADR-011) --------------------------------------------------------------
# worker = run `pnpm dev:worker` alongside the web app (default)
# inline = no worker process; POST /api/jobs/drain processes jobs (free hosted preview)
JOB_RUNNER=worker
JOB_STEP_BUDGET_MS=45000
# Required to call /api/jobs/drain. At least 32 characters, e.g. `openssl rand -hex 32`.
JOB_DRAIN_SECRET=

