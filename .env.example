# Copy to `.env` for local development. Never commit real secrets.
# Tests read `.env.test.local` (NODE_ENV=test), which should point at the bizretriever_test database.

NODE_ENV=development
LOG_LEVEL=info
APP_URL=http://localhost:3000

# --- Database (ARCHITECTURE §6) -------------------------------------------------------------
# One login role per purpose. `pnpm db:setup` creates these roles using the user/password in each
# URL, so the URLs are the single source of truth. Dev-only passwords below; change for any shared DB.
DATABASE_URL_SUPERUSER=postgres://postgres:postgres@localhost:5432/bizretriever
DATABASE_URL_MIGRATE=postgres://bizr_owner:dev_owner_pw@localhost:5432/bizretriever
DATABASE_URL_APP=postgres://bizr_app:dev_app_pw@localhost:5432/bizretriever
DATABASE_URL_ADMIN=postgres://bizr_admin:dev_admin_pw@localhost:5432/bizretriever
DATABASE_URL_TENANT=postgres://bizr_tenant:dev_tenant_pw@localhost:5432/bizretriever

# --- Background jobs (ADR-011) --------------------------------------------------------------
# worker = run `pnpm dev:worker` alongside the web app (default)
# inline = no worker process; POST /api/jobs/drain processes jobs (free hosted preview)
JOB_RUNNER=worker
JOB_STEP_BUDGET_MS=45000
# Required to call /api/jobs/drain. At least 32 characters, e.g. `openssl rand -hex 32`.
JOB_DRAIN_SECRET=

# --- Per-business database logins (ADR-055) ------------------------------------------------------
# Each business's queries run under its own database login (password derived from this secret).
# Required before real customers' data, above all on managed Postgres. Rotate with
# `pnpm --filter @bizr/worker run tenant-logins`. At least 32 characters: `openssl rand -hex 32`.
TENANT_LOGIN_SECRET=

# --- Auth (ADR-012) --------------------------------------------------------------------------
# Signs sessions. At least 32 characters (`openssl rand -hex 32`). Required in production.
BETTER_AUTH_SECRET=
# Google sign-in turns on only when both are set (free OAuth client; see docs/RUNBOOK_GOOGLE_OAUTH.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Without an API key, verification and password-reset emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=BizRetriever <onboarding@resend.dev>
# Sign-in/sign-up rate limiting (on|off). Leave on; only the e2e test server turns it off.
AUTH_RATE_LIMIT=on

# --- AI (ADR-010, ADR-027) ------------------------------------------------------------------
# The owner provides the key. Without it, AI steps fall back to deterministic behaviour.
ANTHROPIC_API_KEY=
AI_MODEL_STRONG=claude-opus-5-5
AI_MODEL_STANDARD=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-5-5
# off | record (replay if recorded, else call live and save) | replay (recordings only, never calls).
# Tests always replay regardless of this setting.
AI_REPLAY_MODE=record
# Hard spend caps in USD (UTC day / month). Live calls are refused once reached.
AI_BUDGET_DAILY_USD=2
AI_BUDGET_MONTHLY_USD=15

# --- File storage (ADR-013) ------------------------------------------------------------------
# local (files under STORAGE_LOCAL_DIR, default .data/uploads) | postgres (free hosted preview)
# | s3 (paid production: S3, R2 or MinIO, settings below)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=
# S3-compatible storage (M17, ADR-067), paid production only: AWS S3, Cloudflare R2 or MinIO.
# R2: S3_REGION=auto, S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com. AWS: S3_REGION only.
# Move existing files first: pnpm --filter @bizr/worker run storage:move -- --to s3
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=

# --- Internal tools and the demo machine (M8) ------------------------------------------------
# Comma-separated emails that may open /admin (AI cost, latency, failures, eval baselines).
ADMIN_EMAILS=
# The sign-in `pnpm demo:up` sets up. Leave the password empty to get a fresh one each time.
DEMO_EMAIL=demo@fernwood.test
DEMO_PASSWORD=

# Linked sources (M10, ADR-058/059). CONNECTOR_SECRET encrypts stored access tokens:
# openssl rand -hex 32. Shopify: the client id and secret of a free Dev Dashboard app
# (docs/RUNBOOK_SHOPIFY.md). Without them, "Connect Shopify" is hidden.
CONNECTOR_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_API_VERSION=2026-07

# Connect other apps (M16, ADR-066). Webhooks need CONNECTOR_SECRET (above) to keep their signing
# secrets sealed. They are never sent to private or internal addresses; `on` allows a receiver on
# localhost for local development only (refused in production).
WEBHOOKS_ALLOW_PRIVATE=off
