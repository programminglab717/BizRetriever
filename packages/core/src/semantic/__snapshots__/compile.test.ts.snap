exports[`compileQuery semantics > compares a breakdown with the period before 1`] = `
"WITH "a0" AS (SELECT j1."channel" AS "d0", SUM((b."line_total" - COALESCE((j1."discount_total" * b."line_total" / NULLIF(b."__w0", 0)), $4::numeric))) AS "v" FROM (SELECT t.*, SUM(t."line_total") OVER (PARTITION BY t."sale_id") AS "__w0" FROM "sale_lines" t WHERE t."_deleted_at" IS NULL) b LEFT JOIN "sales" j1 ON j1."_id" = b."sale_id" AND j1."_deleted_at" IS NULL WHERE j1."sale_date" >= ($1::date::timestamp AT TIME ZONE $2::text) AND j1."sale_date" < ($3::date::timestamp AT TIME ZONE $2::text) AND (j1."status" IS NULL OR NOT (lower(j1."status") = ANY($5::text[]))) GROUP BY j1."channel"),
"a1" AS (SELECT j1."channel" AS "d0", SUM(b."refund_amount") AS "v" FROM "returns" b LEFT JOIN "sales" j1 ON j1."_id" = b."sale_id" AND j1."_deleted_at" IS NULL WHERE b."_deleted_at" IS NULL AND b."return_date" >= $1::date AND b."return_date" < $3::date GROUP BY j1."channel"),
"cur" AS (SELECT k."d0" AS "d0", ((COALESCE(s0."v", 0))::numeric - (COALESCE(COALESCE(s1."v", 0), $6::numeric))::numeric) AS "m_net_sales" FROM (SELECT "d0" FROM "a0" UNION SELECT "d0" FROM "a1") k LEFT JOIN "a0" s0 ON s0."d0" IS NOT DISTINCT FROM k."d0" LEFT JOIN "a1" s1 ON s1."d0" IS NOT DISTINCT FROM k."d0"),
"a3" AS (SELECT j1."channel" AS "d0", SUM((b."line_total" - COALESCE((j1."discount_total" * b."line_total" / NULLIF(b."__w0", 0)), $9::numeric))) AS "v" FROM (SELECT t.*, SUM(t."line_total") OVER (PARTITION BY t."sale_id") AS "__w0" FROM "sale_lines" t WHERE t."_deleted_at" IS NULL) b LEFT JOIN "sales" j1 ON j1."_id" = b."sale_id" AND j1."_deleted_at" IS NULL WHERE j1."sale_date" >= ($7::date::timestamp AT TIME ZONE $2::text) AND j1."sale_date" < ($8::date::timestamp AT TIME ZONE $2::text) AND (j1."status" IS NULL OR NOT (lower(j1."status") = ANY($10::text[]))) GROUP BY j1."channel"),
"a4" AS (SELECT j1."channel" AS "d0", SUM(b."refund_amount") AS "v" FROM "returns" b LEFT JOIN "sales" j1 ON j1."_id" = b."sale_id" AND j1."_deleted_at" IS NULL WHERE b."_deleted_at" IS NULL AND b."return_date" >= $7::date AND b."return_date" < $8::date GROUP BY j1."channel"),
"prev" AS (SELECT k."d0" AS "d0", ((COALESCE(s0."v", 0))::numeric - (COALESCE(COALESCE(s1."v", 0), $11::numeric))::numeric) AS "m_net_sales" FROM (SELECT "d0" FROM "a3" UNION SELECT "d0" FROM "a4") k LEFT JOIN "a3" s0 ON s0."d0" IS NOT DISTINCT FROM k."d0" LEFT JOIN "a4" s1 ON s1."d0" IS NOT DISTINCT FROM k."d0")
SELECT r.*, count(*) OVER () AS "__total" FROM (SELECT k."d0", c."m_net_sales", p."m_net_sales" AS "m_net_sales__prev" FROM (SELECT "d0" FROM "cur" UNION SELECT "d0" FROM "prev") k LEFT JOIN "cur" c ON c."d0" IS NOT DISTINCT FROM k."d0" LEFT JOIN "prev" p ON p."d0" IS NOT DISTINCT FROM k."d0") r ORDER BY "m_net_sales" DESC NULLS LAST, "d0""
`;
